# Copy this file to .env and modify values as needed

# Paths
DOCS_PATH=data/docs
CHROMA_PATH=data/chroma

# Chunking (values in characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding — switch between "sentence_transformers" or "ollama"
EMBED_MODE=sentence_transformers
SENTENCE_MODEL=all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32
EMBED_DEVICE=auto

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# NVIDIA NIM — get your API key at https://build.nvidia.com
# Set EMBED_MODE=nim to activate
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# Other NIM model options:
#   nvidia/llama-3.2-nv-embedqa-1b-v2  (faster)
#   baai/bge-m3                         (multilingual)

# Retrieval
TOP_K=3

# ChromaDB
CHROMA_COLLECTION=rag_docs
CHROMA_UPSERT_BATCH_SIZE=100

# Debug
DEBUG=true

# Logging
LOG_TO_FILE=false
LOG_FILE=logs/app.log