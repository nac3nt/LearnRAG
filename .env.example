# Copy this file to .env and modify values as needed

# Paths
DOCS_PATH=data/docs
CHROMA_PATH=data/chroma

# Chunking (values in characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding (NVIDIA NIM)
EMBED_BATCH_SIZE=32

# NVIDIA NIM - get your API key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_REQUEST_TIMEOUT_SEC=60
NIM_MAX_RETRIES=3
NIM_INITIAL_BACKOFF_SECONDS=1.0
NIM_RETRYABLE_STATUS_CODES=408,409,425,429,500,502,503,504
# Other NIM model options:
#   nvidia/llama-3.2-nv-embedqa-1b-v2  (faster)
#   baai/bge-m3                         (multilingual)

# Retrieval
TOP_K=3

# ChromaDB
CHROMA_COLLECTION=rag_docs
CHROMA_UPSERT_BATCH_SIZE=100
CHROMA_DISTANCE_SPACE=cosine

# Debug
DEBUG=true

# Logging
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=[%(asctime)s] %(levelname)-8s %(name)s - %(message)s
APP_LOG_DATE_FORMAT=%H:%M:%S
APP_LOG_TO_FILE=true
APP_LOG_FILE=logs/app.log
APP_LOG_FILE_ENCODING=utf-8
