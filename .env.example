# Copy this file to .env and modify values as needed

# Paths
DOCS_PATH=data/docs
CHROMA_PATH=data/chroma

# Chunking (semantic soft budgets; token counts are approximate)
CHUNK_STRATEGY=semantic
CHUNK_MAX_TOKENS=220
CHUNK_MIN_TOKENS=80
CHUNK_SIMILARITY_THRESHOLD=0.18
CHUNK_TABLE_ROW_OVERLAP=1

# Fixed/fallback chunking (characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# PDF extraction
PDF_TEXT_EXTRACTION_MODE=plain
PDF_EXTRACT_TABLES=true
PDF_EXTRACT_IMAGES=true
PDF_SAVE_EXTRACTED_IMAGES=true
PDF_IMAGE_OUTPUT_PATH=data/extracted_images

# Embedding (NVIDIA NIM)
EMBED_BATCH_SIZE=32

# NVIDIA NIM - get your API key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_REQUEST_TIMEOUT_SEC=60
NIM_MAX_RETRIES=3
NIM_INITIAL_BACKOFF_SECONDS=1.0
NIM_RETRYABLE_STATUS_CODES=408,409,425,429,500,502,503,504
# Other NIM model options:
#   nvidia/llama-3.2-nv-embedqa-1b-v2  (faster)
#   baai/bge-m3                         (multilingual)

# Image captioning / vision (optional, required for image retrieval)
IMAGE_CAPTION_PROVIDER=none
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_REQUEST_TIMEOUT_SEC=60
VISION_MAX_RETRIES=3
VISION_INITIAL_BACKOFF_SECONDS=1.0
VISION_RETRYABLE_STATUS_CODES=408,409,425,429,500,502,503,504
VISION_DESCRIPTION_PROMPT=Describe the business-relevant contents of this PDF image for retrieval. Transcribe visible text, summarize charts, tables, and diagrams, and keep the answer factual and concise.

# Image embeddings / multimodal retrieval
IMAGE_EMBED_PROVIDER=none
IMAGE_EMBEDDER_CLASS=

# Retrieval
TOP_K=3

# ChromaDB
CHROMA_COLLECTION=rag_docs
CHROMA_IMAGE_COLLECTION=rag_images
CHROMA_UPSERT_BATCH_SIZE=100
CHROMA_DISTANCE_SPACE=cosine

# Debug
DEBUG=true

# Logging
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=[%(asctime)s] %(levelname)-8s %(name)s - %(message)s
APP_LOG_DATE_FORMAT=%H:%M:%S
APP_LOG_TO_FILE=true
APP_LOG_FILE=logs/app.log
APP_LOG_FILE_ENCODING=utf-8
